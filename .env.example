APP_NAME="SRN"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ganti-dengan-domain-produksi.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Backup harian (php artisan app:backup) — lihat app/Console/Commands/BackupData.php
# Di server Linux, path mysqldump biasanya cukup "mysqldump" saja (asal ada di PATH).
MYSQLDUMP_PATH=mysqldump
BACKUP_RETENTION_DAYS=30
# Folder cadangan kedua (opsional) di luar server ini, misal mount rclone/cloud storage.
BACKUP_MIRROR_PATH=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=srn
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true kalau APP_URL pakai https (produksi) supaya cookie sesi dikirim aman.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
